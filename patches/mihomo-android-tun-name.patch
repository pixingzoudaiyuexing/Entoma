diff --git a/listener/sing_tun/failed_stack_gvisor.go b/listener/sing_tun/failed_stack_gvisor.go
new file mode 100644
--- /dev/null
+++ b/listener/sing_tun/failed_stack_gvisor.go
@@ -0,0 +1,11 @@
+//go:build with_gvisor
+
+package sing_tun
+
+import tun "github.com/metacubex/sing-tun"
+
+func closeFailedMixedStack(stack tun.Stack) {
+	if mixed, ok := stack.(*tun.Mixed); ok && mixed != nil && mixed.System != nil {
+		_ = mixed.System.Close()
+	}
+}
